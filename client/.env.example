# URL del backend en producción, incluyendo /api al final.
# Ejemplo: https://prestadiario-api.onrender.com/api
#
# En desarrollo local NO hace falta definirla: Vite redirige /api hacia el
# backend local (ver vite.config.ts).
#
# En producción el frontend vive en Firebase Hosting y el backend en otro
# dominio, por eso la URL tiene que ser absoluta. Como Vite la incrusta en el
# build, hay que definirla ANTES de compilar el cliente.
VITE_API_URL=https://TU-BACKEND.onrender.com/api
