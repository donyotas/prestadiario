# --- Base de datos ---
# En local: un archivo SQLite (la ruta es relativa a server/prisma).
DATABASE_URL="file:./dev.db"
#
# En producción (Turso): usa la URL de tu base de datos y su token.
# DATABASE_URL="libsql://prestadiario-tuusuario.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOi..."

# --- Seguridad ---
# En producción usa un valor largo y aleatorio, distinto al de desarrollo.
JWT_SECRET="change-me"

# --- Servidor ---
# En producción lo define la plataforma; en local 4000.
PORT=4000

# --- Administrador inicial ---
# Solo se usan la primera vez que arranca el servidor contra una base vacía.
ADMIN_EMAIL="admin@prestadiario.local"
ADMIN_PASSWORD="change-me"
ADMIN_NOMBRE="Administrador"

# --- CORS (opcional) ---
# Orígenes permitidos para el navegador, separados por comas. Si no se define,
# se usan localhost:5173 y los dominios de Firebase Hosting del proyecto.
# CORS_ORIGINS="https://prestadiario-3756c.web.app,https://tudominio.com"
